{
  "name": "@herdr/sdk",
  "version": "0.8.2",
  "description": "Effect-native TypeScript SDK for Herdr's local socket API.",
  "homepage": "https://github.com/dmmulroy/herdr-ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/dmmulroy/herdr-ts-sdk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmmulroy/herdr-ts-sdk.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate-wire-types.mjs && vp fmt schema scripts src/generated",
    "build": "vp run generate && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check && pnpm run check:docs && pnpm run check:examples",
    "check:docs": "node scripts/check-public-jsdoc.mjs",
    "check:examples": "tsc --project examples/tsconfig.json",
    "example": "pnpm run build && node --experimental-strip-types",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.0-beta.105",
    "ajv": "^8.20.0",
    "effect": "4.0.0-beta.105"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "herdr": {
    "protocol": 21,
    "upstreamCommit": "4a3b04f59ba3b7d8a15cea187b23e1e80c343b0c"
  }
}
